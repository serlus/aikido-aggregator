---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

const { title = 'AikiHub', description = 'Agregador de notícias, eventos e diretório do aikido — Japão, França, Brasil e América do Sul, em português.' } = Astro.props;

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const u = (p) => base + p.replace(/^\//, '');
const path = Astro.url.pathname;
const isActive = (p) =>
  path === u(p) || path === u(p).replace(/\/$/, '') || path.startsWith(u(p) + '/');
const active = (p) => (isActive(p) ? 'text-black' : 'text-neutral-500');

const nav = [
  ['agenda', 'Agenda'],
  ['noticias', 'Notícias'],
  ['diretorio', 'Diretório'],
  ['status', 'Status'],
];

const photoCredits = [
  ['Jakub Hałun', 'CC BY 4.0', 'https://commons.wikimedia.org/wiki/File:Itsukushima-jinja_torii_at_sunset,_Miyajima,_Japan,_20240816_1829_4161.jpg'],
  ['DXR', 'CC BY-SA 4.0', 'https://commons.wikimedia.org/wiki/File:Kare-sansui_zen_garden,_Ry%C5%8Dan-ji,_Kyoto_20190416_1.jpg'],
  ['Norkiña', 'CC BY-SA 4.0', 'https://commons.wikimedia.org/wiki/File:Kumitachi_de_Aikido_en_Kaizen_Dojo.jpg'],
];
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href={'data:image/svg+xml,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><text y=".9em" font-size="90">合</text></svg>')} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="bg-white text-neutral-900 antialiased selection:bg-neutral-200 selection:text-black min-h-screen flex flex-col overflow-x-hidden font-sans">

    <nav class="sticky top-0 z-100 bg-white/90 backdrop-blur-md border-b border-neutral-900/8 w-full px-6 md:px-12">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <a href={u('')} class="text-base font-bold tracking-tight text-black py-4">
          aiki<span class="text-gold">.</span>hub <span class="text-neutral-400 font-normal hidden sm:inline">/ agregador de aikido</span>
        </a>
        <div class="hidden sm:flex gap-5 md:gap-7 flex-wrap py-4 items-center">
          {nav.map(([slug, label]) => (
            <a
              href={u(slug + '/')}
              class={`text-xs font-medium uppercase tracking-wide hover:text-black transition-colors ${active(slug)}`}
            >{label}</a>
          ))}
        </div>
        <button
          id="nav-toggle"
          class="sm:hidden p-3 -mr-3 text-neutral-700 hover:text-black transition-colors"
          aria-label="Abrir menu"
          aria-expanded="false"
          aria-controls="nav-mobile"
        >
          <Icon name="menu" class="w-5 h-5 nav-icon-open" />
          <Icon name="x" class="w-5 h-5 nav-icon-close hidden" />
        </button>
      </div>
      <div id="nav-mobile" class="sm:hidden hidden border-t border-neutral-100 pb-3" hidden>
        {nav.map(([slug, label]) => (
          <a
            href={u(slug + '/')}
            class={`block py-3 px-1 text-sm font-medium uppercase tracking-wide border-b border-neutral-50 last:border-0 ${isActive(slug) ? 'text-black' : 'text-neutral-500'}`}
          >{label}</a>
        ))}
      </div>
    </nav>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-white border-t border-neutral-200 px-6 sm:px-8">
      <div class="mx-auto max-w-7xl py-12 flex flex-col md:flex-row gap-6 justify-between items-start md:items-center">
        <div>
          <div class="font-bold text-lg tracking-tight mb-1">aiki<span class="text-gold">.</span>hub <span class="text-neutral-400 font-normal">agregador</span></div>
          <p class="text-neutral-500 text-sm font-mono">Título + resumo + link para a fonte original. Conteúdo integral, sempre no site de origem.</p>
        </div>
        <a href={u('status/')} class="flex items-center gap-2 px-3 py-1 rounded-full bg-green-50 text-green-700 border border-green-200 text-xs font-mono hover:bg-green-100 transition-colors">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
          </span>
          Atualizado automaticamente
        </a>
      </div>
      <div class="mx-auto max-w-7xl pb-8 -mt-4">
        <p class="text-[11px] leading-relaxed text-neutral-400 font-mono">
          Fotos: retrato de Morihei Ueshiba (1939, domínio público)
          {photoCredits.map(([artist, license, url], i) => (
            <> · <a href={url} target="_blank" rel="noopener" class="underline decoration-neutral-200 underline-offset-2 hover:text-neutral-600 transition-colors">{artist}</a> ({license})</>
          ))} — via Wikimedia Commons.
        </p>
      </div>
    </footer>

    <script>
      // Menu mobile
      const toggle = document.getElementById('nav-toggle');
      const panel = document.getElementById('nav-mobile');
      toggle?.addEventListener('click', () => {
        const open = panel!.classList.toggle('hidden') === false;
        panel!.toggleAttribute('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
        toggle.querySelector('.nav-icon-open')?.classList.toggle('hidden', open);
        toggle.querySelector('.nav-icon-close')?.classList.toggle('hidden', !open);
      });

      // Reveal on scroll (micro-interação do design system)
      const revealables = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && revealables.length) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        revealables.forEach((el) => io.observe(el));
      } else {
        revealables.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
