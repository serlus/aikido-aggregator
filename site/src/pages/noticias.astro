---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import { news, fmtDate, COUNTRY_NAMES } from '../lib/db.js';

const items = news();
const TYPE_BADGE = {
  news: ['Notícia', 'bg-neutral-100 text-neutral-600 border-neutral-200'],
  seminar: ['Seminário', 'bg-blue-50 text-blue-600 border-blue-100'],
  event: ['Evento', 'bg-emerald-50 text-emerald-600 border-emerald-100'],
};
const LANG = { ja: 'traduzido do japonês', fr: 'traduzido do francês', es: 'traduzido do espanhol', en: 'traduzido do inglês' };
const trunc = (s, n = 200) => (s && s.length > n ? s.slice(0, n).replace(/\s+\S*$/, '') + '…' : s);
---
<Base title="Notícias — AikiHub">
  <section class="w-full bg-white py-24 px-6 md:px-12">
    <div class="max-w-7xl mx-auto">
      <Eyebrow label="Notícias — feed agregado" />
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter text-neutral-900 mb-4 leading-[0.9]">Notícias</h1>
      <p class="text-lg text-neutral-500 font-mono max-w-2xl mb-12">
        Título e resumo em português, com link para o conteúdo completo na fonte original.
      </p>

      <div class="max-w-4xl">
        {items.map((n) => {
          const [typeLabel, typeCls] = TYPE_BADGE[n.type] ?? TYPE_BADGE.news;
          return (
            <a href={n.url} target="_blank" rel="noopener" class="group block border-b border-neutral-200 py-8 first:border-t hover:bg-neutral-50 transition-colors px-4 -mx-4">
              <div class="flex items-center gap-3 mb-3 flex-wrap">
                <span class={`inline-flex gap-1.5 items-center px-3 py-1 rounded-full text-xs font-medium font-mono border ${typeCls}`}>{typeLabel}</span>
                <span class="text-xs text-neutral-500 font-mono font-medium">{n.source_name}</span>
                <div class="h-1 w-1 rounded-full bg-neutral-300"></div>
                <span class="text-xs text-neutral-500 font-mono">{COUNTRY_NAMES[n.source_country] ?? n.source_country}</span>
                {n.published_at && (<>
                  <div class="h-1 w-1 rounded-full bg-neutral-300"></div>
                  <span class="text-xs text-neutral-400 font-mono">{fmtDate(n.published_at)}</span>
                </>)}
              </div>
              <h2 class="text-xl md:text-2xl font-semibold text-neutral-900 leading-snug mb-2 group-hover:text-blue-600 transition-colors">
                {n.title}
              </h2>
              {n.summary_pt && (
                <p class="text-sm text-neutral-500 leading-relaxed font-mono max-w-3xl mb-3">{trunc(n.summary_pt)}</p>
              )}
              <span class="inline-flex items-center gap-2 text-xs text-neutral-400 font-mono">
                {LANG[n.lang] ?? 'original em português'} · ler na fonte
                <Icon name="external-link" class="w-3 h-3 group-hover:text-neutral-900 transition-colors" />
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>
</Base>
