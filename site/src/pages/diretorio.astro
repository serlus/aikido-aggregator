---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import { directory, COUNTRY_NAMES } from '../lib/db.js';

const { roots, byId } = directory();

// ordem de exibição: raiz ueshiba primeiro, depois linhagens principais por nº de orgs
const ueshiba = byId['ueshiba'];
const ordered = [];
function walk(l, depth) {
  ordered.push({ ...l, depth });
  l.children.sort((a, b) => b.orgs.length - a.orgs.length).forEach((c) => walk(c, depth + 1));
}
(ueshiba ? [ueshiba] : roots).forEach((r) => walk(r, 0));
roots.filter((r) => r !== ueshiba).forEach((r) => walk(r, 0));

const KIND = {
  hombu: ['Hombu', 'bg-purple-50 text-purple-600 border-purple-100'],
  federation: ['Federação', 'bg-blue-50 text-blue-600 border-blue-100'],
  confederation: ['Confederação', 'bg-blue-50 text-blue-600 border-blue-100'],
  institute: ['Instituto', 'bg-emerald-50 text-emerald-600 border-emerald-100'],
  dojo: ['Dojo', 'bg-neutral-100 text-neutral-600 border-neutral-200'],
  dojo_hq: ['Dojo sede', 'bg-neutral-100 text-neutral-600 border-neutral-200'],
};
---
<Base title="Diretório — AikiHub">
  <section class="w-full bg-white py-24 px-6 md:px-12">
    <div class="max-w-7xl mx-auto">
      <Eyebrow label="Diretório — linhagens e organizações" />
      <h1 class="text-4xl md:text-6xl font-semibold tracking-tighter text-neutral-900 mb-4 leading-[0.9]">Diretório</h1>
      <p class="text-lg text-neutral-500 font-mono max-w-2xl mb-16">
        A genealogia técnica do aikido — do Fundador às federações e dojos de hoje —
        mapeada a partir da pesquisa do projeto.
      </p>

      {ordered.map((l) => (
        <div class={`mb-14 ${l.depth > 0 ? 'md:ml-10 md:pl-8 md:border-l md:border-neutral-200' : ''}`}>
          <div class="flex items-baseline gap-4 flex-wrap mb-1">
            <h2 class={`font-semibold tracking-tight text-neutral-900 ${l.depth === 0 ? 'text-3xl md:text-4xl' : 'text-2xl'}`}>{l.name}</h2>
            {l.founder && <span class="text-sm text-neutral-500 font-mono">{l.founder}</span>}
          </div>
          {l.notes && <p class="text-sm text-neutral-500 font-mono mb-6 max-w-2xl">{l.notes}</p>}

          {l.orgs.length > 0 && (
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 mt-6">
              {l.orgs.map((o) => {
                const [kindLabel, kindCls] = KIND[o.kind] ?? KIND.dojo;
                const Tag = o.url ? 'a' : 'div';
                return (
                  <Tag
                    {...(o.url ? { href: o.url, target: '_blank', rel: 'noopener' } : {})}
                    class={`group bg-white border border-neutral-200 rounded-2xl p-5 transition-all duration-300 ${o.url ? 'hover:shadow-xl hover:-translate-y-1' : ''}`}
                  >
                    <div class="flex items-start justify-between gap-2 mb-3">
                      <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium font-mono border ${kindCls}`}>{kindLabel}</span>
                      {o.url && <Icon name="arrow-up-right" class="w-4 h-4 text-neutral-300 group-hover:text-neutral-900 transition-colors" />}
                    </div>
                    <div class="text-sm font-semibold text-neutral-900 leading-snug mb-2">{o.name}</div>
                    <div class="text-xs text-neutral-500 font-mono inline-flex items-center gap-1.5">
                      <Icon name="map-pin" class="w-3 h-3" />
                      {[o.city, o.state, COUNTRY_NAMES[o.country] ?? o.country].filter(Boolean).join(' · ')}
                    </div>
                    {o.notes && <p class="text-xs text-neutral-400 font-mono mt-3 leading-relaxed">{o.notes}</p>}
                  </Tag>
                );
              })}
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</Base>
