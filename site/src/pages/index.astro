---
import Base from '../layouts/Base.astro';
import Eyebrow from '../components/Eyebrow.astro';
import Icon from '../components/Icon.astro';
import { Picture } from 'astro:assets';
import { futureEvents, news, stats, fmtRange, fmtDate, COUNTRY_NAMES } from '../lib/db.js';
import torii from '../assets/img/torii-itsukushima.jpg';
import zen from '../assets/img/zen-garden-ryoanji.jpg';

const st = stats();
const events = futureEvents().slice(0, 3);
const latest = news(5);
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
const u = (p) => base + p.replace(/^\//, '');

const statCards = [
  ['Fontes monitoradas', st.sources, 'globe'],
  ['Eventos futuros', st.events, 'calendar'],
  ['Notícias agregadas', st.items, 'newspaper'],
  ['Organizações no diretório', st.orgs, 'users'],
];
---
<Base title="AikiHub — o aikido do mundo, em português">

  <!-- Hero -->
  <header class="relative w-full min-h-[70vh] flex flex-col justify-between p-6 sm:p-12 border-b border-neutral-100 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <Picture
        src={torii}
        formats={['avif', 'webp']}
        widths={[640, 1024, 1600, 2000]}
        sizes="100vw"
        quality={55}
        loading="eager"
        fetchpriority="high"
        alt=""
        class="w-full h-full object-cover object-[70%_55%] saturate-[.85]"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-white/95 via-white/70 to-white/90"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-white/85 via-white/40 to-white/15"></div>
    </div>
    <canvas id="gold-sparks" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>

    <div class="relative z-10 flex justify-between items-start w-full max-w-[1400px] mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-neutral-200 bg-white/70 backdrop-blur-sm text-xs text-neutral-600 font-mono">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        {st.sources} fontes · {Object.keys(COUNTRY_NAMES).length > 0 ? st.countries : 0} países · atualização diária
      </div>
    </div>
    <div class="relative z-10 flex flex-col md:flex-row justify-between items-start md:items-end gap-10 md:gap-12 w-full max-w-[1400px] mx-auto mb-4">
      <div class="max-w-xs space-y-8">
        <p class="text-sm leading-relaxed text-neutral-700 font-medium">
          Notícias e seminários de aikido do Japão, França, Brasil e América do Sul —
          agregados automaticamente e traduzidos para o português.
        </p>
        <a href={u('agenda/')} class="group inline-flex items-center gap-2 text-xs font-bold tracking-widest uppercase border-b border-black pb-1 hover:text-neutral-600 hover:border-neutral-400 transition-all">
          Ver agenda <span class="group-hover:translate-x-0.5 transition-transform duration-300">→</span>
        </a>
      </div>
      <div class="text-left md:text-right">
        <h1 class="text-[clamp(2.75rem,9vw,7rem)] font-semibold tracking-tighter leading-[0.85] text-black">
          <span class="block">O aikido do mundo,</span>
          <span class="block">em português</span>
        </h1>
        <p class="text-[clamp(1.25rem,4vw,2.25rem)] text-neutral-500 font-normal mt-3 tracking-tight">do Hombu Dojo ao Sul do Brasil</p>
      </div>
    </div>
  </header>

  <!-- Stats -->
  <section class="relative w-full py-16 px-6 md:px-12 border-t border-neutral-200 overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <Picture
        src={zen}
        formats={['avif', 'webp']}
        widths={[1024, 1600]}
        sizes="100vw"
        quality={45}
        alt=""
        class="w-full h-full object-cover object-bottom opacity-25 saturate-0"
      />
      <div class="absolute inset-0 bg-white/85"></div>
    </div>
    <div class="relative max-w-7xl mx-auto grid grid-cols-2 lg:grid-cols-4 gap-4">
      {statCards.map(([label, value, icon], i) => (
        <div class="reveal bg-white/90 backdrop-blur-sm border border-neutral-200 rounded-2xl p-5 sm:p-6" style={`transition-delay:${i * 70}ms`}>
          <Icon name={icon} class="w-5 h-5 text-neutral-400 mb-4" />
          <div class="text-3xl sm:text-4xl font-semibold tracking-tighter text-neutral-900">{value}</div>
          <div class="text-xs text-neutral-500 font-mono mt-1">{label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Próximos eventos -->
  <section class="w-full bg-white py-24 px-6 md:px-12 border-t border-neutral-200">
    <div class="max-w-7xl mx-auto">
      <Eyebrow label="01 — Agenda" />
      <div class="reveal flex items-end justify-between mb-12 gap-6 flex-wrap">
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-neutral-900 leading-[0.9]">Próximos eventos</h2>
        <a href={u('agenda/')} class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-900 hover:text-blue-600 transition-colors border-b border-transparent hover:border-blue-600 pb-0.5">
          Agenda completa <Icon name="arrow-right" />
        </a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        {events.map((e, i) => (
          <a href={e.url} target="_blank" rel="noopener" class="reveal group bg-white border border-neutral-200 rounded-2xl p-6 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 block" style={`transition-delay:${i * 70}ms`}>
            <div class="flex items-center gap-2 mb-4">
              <span class="text-xs text-neutral-500 font-mono font-medium">{fmtRange(e.starts_at, e.ends_at)}</span>
              <div class="h-1 w-1 rounded-full bg-neutral-300"></div>
              <span class="text-xs text-neutral-500 font-mono font-medium">{COUNTRY_NAMES[e.country] ?? e.country}</span>
            </div>
            <h3 class="text-xl font-semibold text-neutral-900 mb-3 leading-snug">{e.title}</h3>
            <div class="flex flex-wrap gap-2 text-xs text-neutral-500 font-mono">
              {e.city && <span class="inline-flex items-center gap-1.5"><Icon name="map-pin" class="w-3 h-3" />{e.city}</span>}
              {e.instructor && <span class="inline-flex items-center gap-1.5"><Icon name="user" class="w-3 h-3" />{e.instructor}</span>}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Últimas notícias -->
  <section class="w-full bg-neutral-50 py-24 px-6 md:px-12 border-t border-neutral-200">
    <div class="max-w-7xl mx-auto">
      <Eyebrow label="02 — Notícias" />
      <div class="reveal flex items-end justify-between mb-12 gap-6 flex-wrap">
        <h2 class="text-4xl md:text-6xl font-semibold tracking-tighter text-neutral-900 leading-[0.9]">Últimas notícias</h2>
        <a href={u('noticias/')} class="inline-flex items-center gap-2 text-sm font-semibold text-neutral-900 hover:text-blue-600 transition-colors border-b border-transparent hover:border-blue-600 pb-0.5">
          Todas as notícias <Icon name="arrow-right" />
        </a>
      </div>
      <div class="reveal divide-y divide-neutral-200 border-y border-neutral-200">
        {latest.map((n) => (
          <a href={n.url} target="_blank" rel="noopener" class="group flex items-baseline justify-between gap-6 py-5 hover:bg-white transition-colors px-2 -mx-2">
            <div class="min-w-0">
              <div class="text-base font-medium text-neutral-900 group-hover:text-blue-600 transition-colors truncate">{n.title}</div>
              <div class="text-xs text-neutral-500 font-mono mt-1">{n.source_name} · {COUNTRY_NAMES[n.source_country] ?? n.source_country}</div>
            </div>
            <span class="text-xs text-neutral-400 font-mono whitespace-nowrap">{fmtDate(n.published_at)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <script>
    // Gold sparks — versão leve do hero 3D do design system (torus Three.js avaliado
    // e descartado: ~600 KB de JS p/ efeito decorativo feriria o Lighthouse mobile).
    // Fallback estático: sem partículas quando prefers-reduced-motion.
    const canvas = document.getElementById('gold-sparks') as HTMLCanvasElement | null;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canvas && !reduced) {
      const ctx = canvas.getContext('2d')!;
      const dpr = Math.min(devicePixelRatio || 1, 2);
      let w = 0, h = 0;
      const N = innerWidth < 640 ? 18 : 36;
      const parts = Array.from({ length: N }, () => ({
        x: Math.random(), y: Math.random(),
        r: 0.8 + Math.random() * 1.6,
        vy: 0.02 + Math.random() * 0.05,
        vx: (Math.random() - 0.5) * 0.02,
        tw: Math.random() * Math.PI * 2,
      }));
      const resize = () => {
        w = canvas.offsetWidth; h = canvas.offsetHeight;
        canvas.width = w * dpr; canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };
      resize();
      addEventListener('resize', resize, { passive: true });
      let last = 0;
      const frame = (t: number) => {
        const dt = Math.min((t - last) / 1000, 0.05); last = t;
        ctx.clearRect(0, 0, w, h);
        for (const p of parts) {
          p.y -= p.vy * dt; p.x += p.vx * dt; p.tw += dt * 2;
          if (p.y < -0.02) { p.y = 1.02; p.x = Math.random(); }
          if (p.x < -0.02) p.x = 1.02; else if (p.x > 1.02) p.x = -0.02;
          ctx.globalAlpha = 0.25 + 0.35 * (0.5 + 0.5 * Math.sin(p.tw));
          ctx.fillStyle = '#d4af37';
          ctx.beginPath();
          ctx.arc(p.x * w, p.y * h, p.r, 0, Math.PI * 2);
          ctx.fill();
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  </script>
</Base>
